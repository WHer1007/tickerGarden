# Credentials belong only in the server's protected EnvironmentFile.
TG_ENVIRONMENT=test
TG_DATABASE_SCHEMA=tickergarden_serverless
TG_PIPELINE_GENERATION=0
TG_PIPELINE_DATABASE_URL=postgresql://REPLACE
TG_WORKER_CONTROL_DATABASE_URL=postgresql://REPLACE
TG_WORKER_CONTROL_POOL_MODE=direct
TG_RPC_URL=https://REPLACE
TG_SECONDARY_RPC_URL=https://REPLACE
TG_APPLICATION_REGION=sin1
TG_DATABASE_REGION=singapore
TG_WORKER_REGION=singapore
TG_DB_POOL_MAX_RESIDENT_WORKER=4
TG_DB_POOL_MAX_RESIDENT_CONTROL=1
# Set TG_DB_BUDGET_JSON to the verified, compact connection budget JSON.
TG_DB_BUDGET_JSON=
TG_WORKER_HEALTH_HOST=127.0.0.1
TG_WORKER_HEALTH_PORT=8082
