(queue) {
  request_body {
    max_size 1MB
  }
  header Cache-Control "no-store"
}

(storage) {
  request_body {
    max_size 4MB
  }
}

queue-test.tickergarden.com {
  import queue
  reverse_proxy queue-test:8080
}
queue.tickergarden.com {
  import queue
  handle_path /bsc/* {
    reverse_proxy bsc-queue-prod:8080
  }
  handle {
    reverse_proxy queue-prod:8080
  }
}
