[Unit]
Description=TickerGarden %i alert delivery
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=tickergarden
Group=tickergarden
# Install a tested release on the selected notification host; no auto-start.
WorkingDirectory=/opt/tickergarden-alert-source/services/backend-ts
EnvironmentFile=/etc/tickergarden/alerts-%i.env
ExecStart=/opt/node24/bin/node --experimental-strip-types scripts/alert-worker.ts
Restart=on-failure
RestartSec=15
TimeoutStopSec=15
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/tickergarden-alerts/%i
MemoryMax=256M

[Install]
WantedBy=multi-user.target
