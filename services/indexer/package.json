{
  "name": "@tickergarden/indexer",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "generate:events": "node scripts/generate-v1-events.mjs",
    "check:events": "node scripts/generate-v1-events.mjs --check",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "node --experimental-strip-types src/index.ts",
    "test": "npm run check:events && node --experimental-strip-types --test test/*.test.ts"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "typescript": "7.0.2"
  }
}
