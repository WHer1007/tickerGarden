{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": [
    "sin1"
  ],
  "buildCommand": "node ../../../../tools/deployment-boundary.mjs auto read-api && npm run build --prefix ../..",
  "functions": {
    "api/index.ts": {
      "maxDuration": 20,
      "includeFiles": "../../../../source-release.json"
    },
    "api/events.ts": {
      "maxDuration": 300,
      "includeFiles": "../../../../source-release.json"
    }
  },
  "rewrites": [
    {
      "source": "/v1/explore/events",
      "destination": "/api/events"
    },
    {
      "source": "/v1/stats/events",
      "destination": "/api/events"
    },
    {
      "source": "/v1/markets/:marketId/events",
      "destination": "/api/events"
    },
    {
      "source": "/(.*)",
      "destination": "/api"
    }
  ],
  "installCommand": "npm ci --prefix ../.. --workspaces --include-workspace-root --include=dev --ignore-scripts"
}
