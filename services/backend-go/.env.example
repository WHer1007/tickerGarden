# Development only. make run loads .env; the Go process itself reads environment variables.
TG_ENV=development
TG_HTTP_ADDR=127.0.0.1:8790
TG_CHAIN_ID=46630
TG_LOG_LEVEL=info
TG_WEB_ORIGIN=http://localhost:5193
TG_SHUTDOWN_TIMEOUT=10s
TG_PROBE_TIMEOUT=2s
TG_DB_MAX_CONNS=10
# Empty is allowed for a scaffold boot; /readyz remains 503.
TG_DATABASE_URL=
# Separate migration connection; never used by the HTTP process.
TG_MIGRATION_DATABASE_URL=

# Raw chain journal: explicitly configure before running the indexer.
TG_INDEXER_DATABASE_URL=
TG_RPC_URL=
# Required; obtain the production value from a verified deployment manifest.
TG_INDEXER_START_BLOCK=

# Trusted reconciled-snapshot publisher only; never used by the HTTP process.
TG_PUBLISHER_DATABASE_URL=

# Finalized market discovery; run after journal ingestion and migrations.
TG_DISCOVERY_DATABASE_URL=
TG_DEPLOYMENT_MANIFEST=
# First fully deployed core block to scan (decimal, at or after journal start).
TG_DISCOVERY_START_BLOCK=

# Business facts only; no automatic reconciled snapshot publication.
TG_PROJECTION_DATABASE_URL=
# Must equal the persisted discovery start block.
TG_PROJECTION_START_BLOCK=

# Read-only Treasury candidate history source; separate from API/writer credentials.
TG_TREASURY_DATABASE_URL=

# Candidate artifact writer: SELECT chain provenance, SELECT/INSERT treasury_candidates.
TG_TREASURY_STORE_DATABASE_URL=

# Optional claim-proof HTTP: explicit Go deployment manifest with pinned Treasury/core.
# Reads TG_DATABASE_URL using SELECT-only candidate/journal privileges and TG_RPC_URL.
TG_TREASURY_PROOF_MANIFEST=

# Durable Treasury queue + candidate writer, never consumed by public HTTP.
TG_TREASURY_JOBS_DATABASE_URL=

# Dedicated operator login for audited dead-job recovery; never used by worker/API.
TG_TREASURY_OPERATOR_DATABASE_URL=

# Independent candidate reviewer login + separately configured journal/RPC.
TG_TREASURY_REVIEW_DATABASE_URL=
TG_TREASURY_REVIEW_JOURNAL_URL=
TG_TREASURY_REVIEW_RPC_URL=
# Read-only publisher preparation connection; never signs or broadcasts.
TG_TREASURY_PUBLISH_DATABASE_URL=
TG_TREASURY_PUBLISH_RPC_URL=

# Treasury pending-root observation and unsigned lifecycle preparation.
TG_TREASURY_LIFECYCLE_RPC_URL=
# Read-only access to candidates, reviews and their canonical journal anchors.
TG_TREASURY_LIFECYCLE_DATABASE_URL=

# Independent immutable metadata HTTP service: content-worker --run
TG_CONTENT_DATABASE_URL=
TG_CONTENT_HTTP_ADDR=127.0.0.1:8791
TG_CONTENT_PUBLIC_ORIGIN=http://localhost:8791
TG_CONTENT_WEB_ORIGIN=http://localhost:5173

# Dedicated operator credential for reviewed legacy-content imports.
TG_CONTENT_IMPORT_DATABASE_URL=

# Finalized creation-block identity enrichment (requires discovery first).
TG_MARKET_IDENTITY_DATABASE_URL=

# Enrich every published market from canonical persisted identity observations.
TG_PUBLISH_IDENTITIES=false

# Read-only persisted reconciliation evidence inspection (independent SELECT role).
TG_RECONCILIATION_DATABASE_URL=

# Read-only pipeline monitoring; no credentials shared with writers.
TG_STATUS_DATABASE_URL=
TG_STATUS_MAX_LAG_BLOCKS=100
TG_STATUS_MAX_PROGRESS_AGE=15m

# Optional live chain identity/head/finality checks for backend-status.
TG_STATUS_RPC_URL=

# Independent maintenance pipeline (scanner/preparer/signer/reconciler).
TG_MAINTENANCE_DATABASE_URL=
TG_MAINTENANCE_FROM=
TG_MAINTENANCE_POLL_INTERVAL=5s
# Explicit fee settings are required by maintenance-preparer; no default spending values.
TG_MAINTENANCE_GAS_LIMIT=
TG_MAINTENANCE_MAX_FEE_PER_GAS=
TG_MAINTENANCE_PRIORITY_FEE_PER_GAS=
# Absolute, operator-managed executable; sign only, never broadcast.
TG_MAINTENANCE_SIGNER=
# Separate budget configuration/inspection operator; never shared with submission workers.
TG_MAINTENANCE_OPERATOR_DATABASE_URL=

# Operator-owned per-market signature/reference policy for settlement-worker --reference-check.
# No real providers are configured by default; candidate input cannot replace this policy.
TG_SETTLEMENT_REFERENCE_POLICY=

# Dedicated settlement credentials; use the shared coordination database for account-role isolation.
TG_SETTLEMENT_DATABASE_URL=

# JSON policy for unsigned settlement intent fee bounds.
TG_SETTLEMENT_EXECUTION_POLICY=

# Absolute executable path; settlement signer must never broadcast.
TG_SETTLEMENT_SIGNER_COMMAND=

# Independent lanes: configure separate RPC quota and DB roles in deployment.
# EVENT/ACTIVITY start blocks must match discovery. Empty RPC overrides fall back to TG_RPC_URL.
TG_EVENT_DATABASE_URL=
TG_EVENT_START_BLOCK=
TG_EVENT_RPC_URL=
TG_EVENT_HTTP_ADDR=127.0.0.1:18562
TG_ACTIVITY_DATABASE_URL=
TG_ACTIVITY_START_BLOCK=
TG_ACTIVITY_RPC_URL=
TG_TRANSACTION_DATABASE_URL=
TG_TRANSACTION_RPC_URL=
TG_PROJECTION_RPC_URL=
TG_PROJECTION_PAUSE_MS=0
# Hash-pinned durable Fee/Holder jobs (migration 00069). Opt in per deployment.
TG_SCOPED_OBSERVATIONS=0
# Optional separate archive provider quota; otherwise uses projection RPC.
TG_OBSERVATION_RPC_URL=

# Testnet uses the existing finalized Go indexer. This is also the default.
TG_TOKEN_DETAIL_SOURCE=indexer
# Optional Dune: explicitly set TG_TOKEN_DETAIL_SOURCE=dune-first, then configure
# both values together, only on the server. See docs/dune/README.md.
# TG_DUNE_DETAIL_QUERY_ID=YOUR_SAVED_QUERY_ID
# TG_DUNE_API_KEY=SET_IN_SERVER_SECRET_ENVIRONMENT

# Launch metadata publication: http (default) or ipfs (Pinata public network).
# Secret belongs only on the server. Set in the environment used by content-worker.
TG_CONTENT_STORAGE=http
PINATA_JWT=

# Durable CID receipts; mount persistent storage here in production (single content-worker).
TG_CONTENT_IPFS_CACHE_DIR=.state/ipfs-publications

# Optional public Pinata group (v3 upload group_id).
PINATA_GROUP_ID=
