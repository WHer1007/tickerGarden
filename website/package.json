{
  "name": "website",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run check:generated && npm run typecheck && vite build && node scripts/prepare-sites-build.mjs",
    "generate:abis": "node scripts/generate-v2-abis.mjs",
    "generate:client": "node scripts/sync-v2-read-client.mjs",
    "generate": "npm run generate:abis && npm run generate:client",
    "check:abis": "node scripts/generate-v2-abis.mjs --check",
    "check:client": "node scripts/sync-v2-read-client.mjs --check",
    "check:generated": "npm run check:abis && npm run check:client",
    "typecheck": "tsc -p tsconfig.json",
    "preview": "vite preview",
    "test": "npm run check:generated && npm run typecheck && npm run test:unit && npm run test:sites",
    "test:unit": "node --experimental-strip-types --test tests/*.test.ts",
    "test:sites": "node --test tests/sites-worker.test.mjs"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/fraunces": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "@vitejs/plugin-react": "5.0.4",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "viem": "^2.56.3",
    "vite": "6.4.2",
    "wagmi": "^3.7.7"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "typescript": "^5.9.3"
  }
}
