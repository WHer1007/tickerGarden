# Required V2 read API endpoint:
# VITE_V2_READ_API_URL=NOT_CONFIGURED_NON_PRODUCTION
#
# Required lowercase, non-zero contract addresses (examples are deliberately
# invalid and are not deployable addresses):
# VITE_V2_FACTORY_ADDRESS=NOT_A_DEPLOYABLE_ADDRESS
# VITE_V2_LAUNCH_ROUTER_ADDRESS=NOT_A_DEPLOYABLE_ADDRESS
# VITE_V2_ALLOCATION_MANAGER_ADDRESS=NOT_A_DEPLOYABLE_ADDRESS
# VITE_V2_PROTOCOL_FEE_VAULT_ADDRESS=NOT_A_DEPLOYABLE_ADDRESS

# Do not add private keys, wallet secrets, or signer configuration here.
