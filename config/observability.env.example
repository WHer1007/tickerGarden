# Copy into an ignored local file or secret manager. Never commit populated values.
# Separate Sentry projects / alert spools for test and production.
TG_LOG_LEVEL=info
TG_RELEASE_COMMIT=
TG_SENTRY_DSN=
# Public ingest DSN only, never an auth token. Omit to disable browser uploads.
VITE_SENTRY_DSN=
VITE_TG_ENVIRONMENT=
VITE_RELEASE_COMMIT=
# Build-only; never prefix with VITE_. All three required to upload private maps.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
# Dedicated notification process only. Not consumed by browser/API requests.
TG_ALERT_SPOOL_DIR=
TG_LARK_WEBHOOK_URL=
TG_LARK_SIGNING_SECRET=
# Optional central intake. Generate an independent random token per environment.
# Web/API services: HTTPS intake URL + token. VPS workers: private spool directory.
TG_ALERT_INGEST_URL=
TG_ALERT_INGEST_TOKEN=
TG_ALERT_PORT=8090
TG_ALERT_DELIVERY_ENABLED=false
