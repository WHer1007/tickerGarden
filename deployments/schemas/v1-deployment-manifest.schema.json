{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tickergarden.local/schemas/v1-deployment-manifest.schema.json",
  "title": "TickerGarden V1 deployment manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "manifestKind",
    "executionSpecId",
    "releaseStatus",
    "readinessCertificate",
    "chain",
    "externalDependencies",
    "protocolModules",
    "configSnapshot",
    "quoteAssets",
    "officialStocks",
    "create2",
    "hook",
    "accessManager",
    "livePreflight",
    "tests",
    "roleHandoff",
    "evidence"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "releaseStatus": {
            "const": "PRODUCTION_CANDIDATE"
          }
        },
        "required": [
          "releaseStatus"
        ]
      },
      "then": {
        "properties": {
          "chain": {
            "type": "object",
            "properties": {
              "chainId": {
                "const": 4663
              }
            },
            "required": [
              "chainId"
            ]
          }
        }
      }
    }
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "manifestKind": {
      "const": "TICKERGARDEN_V1_NETWORK_DEPLOYMENT"
    },
    "executionSpecId": {
      "const": "V1-EXEC-11"
    },
    "releaseStatus": {
      "enum": [
        "DEPLOYMENT_CANDIDATE",
        "PRODUCTION_CANDIDATE"
      ]
    },
    "readinessCertificate": {
      "$ref": "#/$defs/readinessCertificate"
    },
    "chain": {
      "$ref": "#/$defs/chainEvidence"
    },
    "externalDependencies": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "poolManager",
        "positionManager",
        "stateView",
        "permit2"
      ],
      "properties": {
        "poolManager": {
          "$ref": "#/$defs/externalContract"
        },
        "positionManager": {
          "$ref": "#/$defs/externalContract"
        },
        "stateView": {
          "$ref": "#/$defs/externalContract"
        },
        "permit2": {
          "$ref": "#/$defs/externalContract"
        }
      }
    },
    "protocolModules": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "OfficialStockRegistryV1",
        "ApprovedQuoteRegistry",
        "TickerGardenBaselineRegistry",
        "LaunchTemplateRegistry",
        "LaunchConfigResolver",
        "TickerGardenFactoryV1",
        "MarketRegistryV1",
        "LaunchAndBuyRouter",
        "TickerMemeTokenV1",
        "TickerGardenCurve",
        "UserStockVault",
        "AllocationManager",
        "MemeStockGauge",
        "TickerGardenMemeHook",
        "ProtocolFeeVault",
        "GraduationExecutor",
        "LaunchLocker",
        "CreatorRevenueRegistry",
        "HolderRewardsDistributorV1"
      ],
      "properties": {
        "OfficialStockRegistryV1": {
          "$ref": "#/$defs/moduleDeployment"
        },
        "ApprovedQuoteRegistry": {
          "$ref": "#/$defs/moduleDeployment"
        },
        "TickerGardenBaselineRegistry": {
          "$ref": "#/$defs/moduleDeployment"
        },
        "LaunchTemplateRegistry": {
          "$ref": "#/$defs/moduleDeployment"
        },
        "LaunchConfigResolver": {
          "$ref": "#/$defs/moduleDeployment"
        },
        "TickerGardenFactoryV1": {
          "$ref": "#/$defs/moduleDeployment"
        },
        "MarketRegistryV1": {
          "$ref": "#/$defs/moduleDeployment"
        },
        "LaunchAndBuyRouter": {
          "$ref": "#/$defs/moduleDeployment"
        },
        "TickerMemeTokenV1": {
          "$ref": "#/$defs/moduleDeployment"
        },
        "TickerGardenCurve": {
          "$ref": "#/$defs/moduleDeployment"
        },
        "UserStockVault": {
          "$ref": "#/$defs/moduleDeployment"
        },
        "AllocationManager": {
          "$ref": "#/$defs/moduleDeployment"
        },
        "MemeStockGauge": {
          "$ref": "#/$defs/moduleDeployment"
        },
        "TickerGardenMemeHook": {
          "$ref": "#/$defs/moduleDeployment"
        },
        "ProtocolFeeVault": {
          "$ref": "#/$defs/moduleDeployment"
        },
        "GraduationExecutor": {
          "$ref": "#/$defs/moduleDeployment"
        },
        "LaunchLocker": {
          "$ref": "#/$defs/moduleDeployment"
        },
        "CreatorRevenueRegistry": {
          "$ref": "#/$defs/moduleDeployment"
        },
        "HolderRewardsDistributorV1": {
          "$ref": "#/$defs/moduleDeployment"
        }
      }
    },
    "configSnapshot": {
      "$ref": "#/$defs/configSnapshot"
    },
    "quoteAssets": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/quoteAsset"
      }
    },
    "officialStocks": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/officialStock"
      }
    },
    "create2": {
      "$ref": "#/$defs/create2Evidence"
    },
    "hook": {
      "$ref": "#/$defs/hookEvidence"
    },
    "accessManager": {
      "$ref": "#/$defs/accessManagerEvidence"
    },
    "livePreflight": {
      "$ref": "#/$defs/livePreflight"
    },
    "tests": {
      "$ref": "#/$defs/testEvidence"
    },
    "roleHandoff": {
      "$ref": "#/$defs/roleHandoff"
    },
    "evidence": {
      "$ref": "#/$defs/evidenceArray"
    }
  },
  "$defs": {
    "address": {
      "type": "string",
      "pattern": "^0x[0-9a-fA-F]{40}$"
    },
    "nonZeroAddress": {
      "type": "string",
      "pattern": "^0x(?!0{40}$)[0-9a-fA-F]{40}$"
    },
    "bytes32": {
      "type": "string",
      "pattern": "^0x(?!0{64}$)[0-9a-fA-F]{64}$"
    },
    "storageWord": {
      "type": "string",
      "pattern": "^0x[0-9a-fA-F]{64}$"
    },
    "bytes4": {
      "type": "string",
      "pattern": "^0x[0-9a-fA-F]{8}$"
    },
    "hexData": {
      "type": "string",
      "pattern": "^0x(?:[0-9a-fA-F]{2})+$"
    },
    "decimalString": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$"
    },
    "nonEmptyString": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "deploymentGateId": {
      "enum": [
        "V1-DEPLOY-CHAIN-SNAPSHOT-01",
        "V1-DEPLOY-ARTIFACT-CODEHASH-01",
        "V1-DEPLOY-CREATE2-VECTORS-01",
        "V1-DEPLOY-HOOK-MASK-01",
        "V1-DEPLOY-PERMISSIONS-01",
        "V1-DEPLOY-ABI-DIFF-01",
        "V1-DEPLOY-PRODUCT-FORK-E2E-01"
      ]
    },
    "readinessCertificate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "executionManifestHash",
        "compiledInterfaceManifestHash",
        "closedDeploymentGateEvidence"
      ],
      "properties": {
        "state": {
          "enum": [
            "DEPLOYMENT_ELIGIBLE",
            "PRODUCTION_READY"
          ]
        },
        "executionManifestHash": {
          "$ref": "#/$defs/bytes32"
        },
        "compiledInterfaceManifestHash": {
          "$ref": "#/$defs/bytes32"
        },
        "closedDeploymentGateEvidence": {
          "type": "array",
          "minItems": 7,
          "maxItems": 7,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/deploymentGateId"
          }
        }
      }
    },
    "chainEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "chainId",
        "network",
        "rpcUrls",
        "finalizedBlockNumber",
        "finalizedBlockHash",
        "observedAt",
        "evmVersion"
      ],
      "properties": {
        "chainId": {
          "enum": [
            4663,
            46630,
            421614
          ]
        },
        "network": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "rpcUrls": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^(https?|wss)://\\S+$"
          }
        },
        "finalizedBlockNumber": {
          "$ref": "#/$defs/decimalString"
        },
        "finalizedBlockHash": {
          "$ref": "#/$defs/bytes32"
        },
        "observedAt": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
        },
        "evmVersion": {
          "const": "cancun"
        }
      }
    },
    "externalContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "address",
        "runtimeCodeHash",
        "versionOrCommit"
      ],
      "properties": {
        "address": {
          "$ref": "#/$defs/nonZeroAddress"
        },
        "runtimeCodeHash": {
          "$ref": "#/$defs/bytes32"
        },
        "versionOrCommit": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    },
    "moduleDeployment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "moduleKind",
        "sourceName",
        "contractName",
        "artifactPath",
        "compilerVersion",
        "sourceHash",
        "artifactHash",
        "abiHash",
        "creationCodeHash",
        "runtimeCodeHash",
        "constructorArgsHash",
        "immutableArgsHash",
        "deployedAddress",
        "deployer",
        "sourceVerified"
      ],
      "properties": {
        "moduleKind": {
          "enum": [
            "SHARED_IMMUTABLE",
            "PER_ASSET_IMPLEMENTATION",
            "PER_MARKET_IMPLEMENTATION",
            "CLONE_IMPLEMENTATION"
          ]
        },
        "sourceName": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "contractName": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "artifactPath": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "compilerVersion": {
          "const": "0.8.26+commit.8a97fa7a"
        },
        "sourceHash": {
          "$ref": "#/$defs/bytes32"
        },
        "artifactHash": {
          "$ref": "#/$defs/bytes32"
        },
        "abiHash": {
          "$ref": "#/$defs/bytes32"
        },
        "creationCodeHash": {
          "$ref": "#/$defs/bytes32"
        },
        "runtimeCodeHash": {
          "$ref": "#/$defs/bytes32"
        },
        "constructorArgsHash": {
          "$ref": "#/$defs/bytes32"
        },
        "immutableArgsHash": {
          "$ref": "#/$defs/bytes32"
        },
        "deployedAddress": {
          "$ref": "#/$defs/nonZeroAddress"
        },
        "deployer": {
          "$ref": "#/$defs/nonZeroAddress"
        },
        "sourceVerified": {
          "const": true
        }
      }
    },
    "configSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tickerGardenBaselineIds",
        "quoteConfigIds",
        "launchTemplateIds",
        "feePolicyId",
        "launchFeeRaw",
        "numericBoundsHash",
        "officialStockCatalogHash",
        "snapshotHash"
      ],
      "properties": {
        "tickerGardenBaselineIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/bytes32"
          }
        },
        "quoteConfigIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/bytes32"
          }
        },
        "launchTemplateIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/bytes32"
          }
        },
        "feePolicyId": {
          "$ref": "#/$defs/bytes32"
        },
        "launchFeeRaw": {
          "$ref": "#/$defs/decimalString"
        },
        "numericBoundsHash": {
          "$ref": "#/$defs/bytes32"
        },
        "officialStockCatalogHash": {
          "$ref": "#/$defs/bytes32"
        },
        "snapshotHash": {
          "$ref": "#/$defs/bytes32"
        }
      }
    },
    "quoteAsset": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "configId",
            "tickerGardenBaselineId",
            "economicsHash",
            "assetKind",
            "tokenAddress",
            "decimals",
            "phantomQuote",
            "graduationThreshold",
            "observationBlockHash",
            "exactBalanceDeltaEvidenceHash"
          ],
          "properties": {
            "configId": {
              "$ref": "#/$defs/bytes32"
            },
            "tickerGardenBaselineId": {
              "$ref": "#/$defs/bytes32"
            },
            "economicsHash": {
              "$ref": "#/$defs/bytes32"
            },
            "assetKind": {
              "const": "NATIVE"
            },
            "tokenAddress": {
              "const": "0x0000000000000000000000000000000000000000"
            },
            "decimals": {
              "const": 18
            },
            "phantomQuote": {
              "$ref": "#/$defs/decimalString"
            },
            "graduationThreshold": {
              "$ref": "#/$defs/decimalString"
            },
            "observationBlockHash": {
              "$ref": "#/$defs/bytes32"
            },
            "exactBalanceDeltaEvidenceHash": {
              "$ref": "#/$defs/bytes32"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "configId",
            "tickerGardenBaselineId",
            "economicsHash",
            "assetKind",
            "tokenAddress",
            "decimals",
            "phantomQuote",
            "graduationThreshold",
            "runtimeCodeHash",
            "proxyKind",
            "observationBlockHash",
            "exactBalanceDeltaEvidenceHash"
          ],
          "properties": {
            "configId": {
              "$ref": "#/$defs/bytes32"
            },
            "tickerGardenBaselineId": {
              "$ref": "#/$defs/bytes32"
            },
            "economicsHash": {
              "$ref": "#/$defs/bytes32"
            },
            "assetKind": {
              "const": "ERC20"
            },
            "tokenAddress": {
              "$ref": "#/$defs/nonZeroAddress"
            },
            "decimals": {
              "type": "integer",
              "minimum": 6,
              "maximum": 18
            },
            "phantomQuote": {
              "$ref": "#/$defs/decimalString"
            },
            "graduationThreshold": {
              "$ref": "#/$defs/decimalString"
            },
            "runtimeCodeHash": {
              "$ref": "#/$defs/bytes32"
            },
            "proxyKind": {
              "type": "string",
              "minLength": 1
            },
            "implementationAddress": {
              "$ref": "#/$defs/nonZeroAddress"
            },
            "implementationCodeHash": {
              "$ref": "#/$defs/bytes32"
            },
            "observationBlockHash": {
              "$ref": "#/$defs/bytes32"
            },
            "exactBalanceDeltaEvidenceHash": {
              "$ref": "#/$defs/bytes32"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "configId",
            "tickerGardenBaselineId",
            "economicsHash",
            "assetKind",
            "assetUid",
            "tokenAddress",
            "decimals",
            "phantomQuote",
            "graduationThreshold",
            "stockTokenFingerprintHash",
            "referenceEvidenceHash",
            "generatorPolicyId",
            "runtimeCodeHash",
            "proxyKind",
            "beaconAddress",
            "beaconCodeHash",
            "implementationAddress",
            "implementationCodeHash",
            "observationBlockHash",
            "exactBalanceDeltaEvidenceHash"
          ],
          "properties": {
            "configId": {
              "$ref": "#/$defs/bytes32"
            },
            "tickerGardenBaselineId": {
              "$ref": "#/$defs/bytes32"
            },
            "economicsHash": {
              "$ref": "#/$defs/bytes32"
            },
            "assetKind": {
              "const": "OFFICIAL_STOCK"
            },
            "assetUid": {
              "$ref": "#/$defs/bytes32"
            },
            "tokenAddress": {
              "$ref": "#/$defs/nonZeroAddress"
            },
            "decimals": {
              "type": "integer",
              "minimum": 6,
              "maximum": 18
            },
            "phantomQuote": {
              "$ref": "#/$defs/decimalString"
            },
            "graduationThreshold": {
              "$ref": "#/$defs/decimalString"
            },
            "stockTokenFingerprintHash": {
              "$ref": "#/$defs/bytes32"
            },
            "referenceEvidenceHash": {
              "$ref": "#/$defs/bytes32"
            },
            "generatorPolicyId": {
              "$ref": "#/$defs/bytes32"
            },
            "runtimeCodeHash": {
              "$ref": "#/$defs/bytes32"
            },
            "proxyKind": {
              "const": "IMMUTABLE_BEACON"
            },
            "beaconAddress": {
              "$ref": "#/$defs/nonZeroAddress"
            },
            "beaconCodeHash": {
              "$ref": "#/$defs/bytes32"
            },
            "implementationAddress": {
              "$ref": "#/$defs/nonZeroAddress"
            },
            "implementationCodeHash": {
              "$ref": "#/$defs/bytes32"
            },
            "observationBlockHash": {
              "$ref": "#/$defs/bytes32"
            },
            "exactBalanceDeltaEvidenceHash": {
              "$ref": "#/$defs/bytes32"
            }
          }
        }
      ]
    },
    "officialStock": {
      "oneOf": [
        {
          "$ref": "#/$defs/directOfficialStock"
        },
        {
          "$ref": "#/$defs/beaconOfficialStock"
        }
      ]
    },
    "directOfficialStock": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assetUid",
        "tokenAddress",
        "decimals",
        "runtimeCodeHash",
        "proxyKind",
        "implementationAddress",
        "implementationCodeHash",
        "observationBlockHash",
        "exactBalanceDeltaEvidenceHash"
      ],
      "properties": {
        "assetUid": {
          "$ref": "#/$defs/bytes32"
        },
        "tokenAddress": {
          "$ref": "#/$defs/nonZeroAddress"
        },
        "decimals": {
          "type": "integer",
          "minimum": 6,
          "maximum": 18
        },
        "runtimeCodeHash": {
          "$ref": "#/$defs/bytes32"
        },
        "proxyKind": {
          "const": "DIRECT"
        },
        "implementationAddress": {
          "$ref": "#/$defs/nonZeroAddress"
        },
        "implementationCodeHash": {
          "$ref": "#/$defs/bytes32"
        },
        "observationBlockHash": {
          "$ref": "#/$defs/bytes32"
        },
        "exactBalanceDeltaEvidenceHash": {
          "$ref": "#/$defs/bytes32"
        },
        "minimumAllocation": {
          "type": "string",
          "pattern": "^[1-9][0-9]*$",
          "description": "Raw-token minimum total stake; mandatory in the RH production release preflight."
        }
      }
    },
    "beaconOfficialStock": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assetUid",
        "tokenAddress",
        "decimals",
        "runtimeCodeHash",
        "proxyKind",
        "beaconAddress",
        "beaconCodeHash",
        "implementationAddress",
        "implementationCodeHash",
        "observationBlockHash",
        "exactBalanceDeltaEvidenceHash"
      ],
      "properties": {
        "assetUid": {
          "$ref": "#/$defs/bytes32"
        },
        "tokenAddress": {
          "$ref": "#/$defs/nonZeroAddress"
        },
        "decimals": {
          "type": "integer",
          "minimum": 6,
          "maximum": 18
        },
        "runtimeCodeHash": {
          "$ref": "#/$defs/bytes32"
        },
        "proxyKind": {
          "const": "IMMUTABLE_BEACON"
        },
        "beaconAddress": {
          "$ref": "#/$defs/nonZeroAddress"
        },
        "beaconCodeHash": {
          "$ref": "#/$defs/bytes32"
        },
        "implementationAddress": {
          "$ref": "#/$defs/nonZeroAddress"
        },
        "implementationCodeHash": {
          "$ref": "#/$defs/bytes32"
        },
        "observationBlockHash": {
          "$ref": "#/$defs/bytes32"
        },
        "exactBalanceDeltaEvidenceHash": {
          "$ref": "#/$defs/bytes32"
        },
        "minimumAllocation": {
          "type": "string",
          "pattern": "^[1-9][0-9]*$",
          "description": "Raw-token minimum total stake; mandatory in the RH production release preflight."
        }
      }
    },
    "create2Component": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "deploymentKind",
        "deployer",
        "saltDomain",
        "salt",
        "initCodeHash",
        "runtimeCodeHash",
        "constructorArgsHash",
        "immutableArgsHash",
        "predictedAddress",
        "actualAddress",
        "collisionPolicy"
      ],
      "properties": {
        "deploymentKind": {
          "enum": [
            "FULL_CREATE2",
            "ERC1167_IMMUTABLE_ARGS_CLONE"
          ]
        },
        "deployer": {
          "$ref": "#/$defs/nonZeroAddress"
        },
        "saltDomain": {
          "$ref": "#/$defs/bytes32"
        },
        "salt": {
          "$ref": "#/$defs/bytes32"
        },
        "initCodeHash": {
          "$ref": "#/$defs/bytes32"
        },
        "runtimeCodeHash": {
          "$ref": "#/$defs/bytes32"
        },
        "constructorArgsHash": {
          "$ref": "#/$defs/bytes32"
        },
        "immutableArgsHash": {
          "$ref": "#/$defs/bytes32"
        },
        "implementationAddress": {
          "$ref": "#/$defs/nonZeroAddress"
        },
        "implementationCodeHash": {
          "$ref": "#/$defs/bytes32"
        },
        "predictedAddress": {
          "$ref": "#/$defs/nonZeroAddress"
        },
        "actualAddress": {
          "$ref": "#/$defs/nonZeroAddress"
        },
        "collisionPolicy": {
          "const": "REVERT_NO_NONCE_FALLBACK"
        }
      }
    },
    "fullCreate2Component": {
      "allOf": [
        {
          "$ref": "#/$defs/create2Component"
        },
        {
          "type": "object",
          "properties": {
            "deploymentKind": {
              "const": "FULL_CREATE2"
            },
            "implementationAddress": false,
            "implementationCodeHash": false
          }
        }
      ]
    },
    "gaugeCloneComponent": {
      "allOf": [
        {
          "$ref": "#/$defs/create2Component"
        },
        {
          "type": "object",
          "required": [
            "implementationAddress",
            "implementationCodeHash"
          ],
          "properties": {
            "deploymentKind": {
              "const": "ERC1167_IMMUTABLE_ARGS_CLONE"
            },
            "implementationAddress": {
              "$ref": "#/$defs/nonZeroAddress"
            },
            "implementationCodeHash": {
              "$ref": "#/$defs/bytes32"
            }
          }
        }
      ]
    },
    "create2Evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "marketId",
        "creator",
        "components",
        "predictionVectorHash",
        "predictionMatchesDeployment"
      ],
