{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tickergarden.local/schemas/v1-testnet-deployment-plan.schema.json",
  "title": "TickerGarden V1 testnet deployment plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "manifestKind",
    "executionSpecId",
    "target",
    "chain",
    "dependencyProvenance",
    "externalDependencies",
    "deterministicDeployment",
    "configurationInputs",
    "forkEvidence",
    "deploymentGateEvidence",
    "limitations"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "manifestKind": {
      "const": "TICKERGARDEN_V1_TESTNET_DEPLOYMENT_PLAN"
    },
    "executionSpecId": {
      "const": "V1-EXEC-11"
    },
    "target": {
      "enum": [
        "ROBINHOOD_CHAIN_TESTNET_REHEARSAL",
        "ARBITRUM_SEPOLIA_V4_INTEGRATION"
      ]
    },
    "chain": {
      "$ref": "#/$defs/chain"
    },
    "dependencyProvenance": {
      "$ref": "#/$defs/dependencyProvenance"
    },
    "externalDependencies": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": {
        "$ref": "#/$defs/dependency"
      }
    },
    "deterministicDeployment": {
      "$ref": "#/$defs/deterministicDeployment"
    },
    "configurationInputs": {
      "type": "array",
      "minItems": 27,
      "maxItems": 27,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Z][A-Z0-9_]+$"
      }
    },
    "forkEvidence": {
      "$ref": "#/$defs/forkEvidence"
    },
    "deploymentGateEvidence": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": {
        "$ref": "#/$defs/gateEvidence"
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 3,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/nonEmptyString"
      }
    },
    "productionTargetChainId": {
      "const": 4663
    }
  },
  "$defs": {
    "address": {
      "type": "string",
      "pattern": "^0x(?!0{40}$)[0-9a-fA-F]{40}$"
    },
    "bytes32": {
      "type": "string",
      "pattern": "^0x(?!0{64}$)[0-9a-fA-F]{64}$"
    },
    "decimalString": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$"
    },
    "nonEmptyString": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "utcTimestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "blockSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "number",
        "hash",
        "timestamp"
      ],
      "properties": {
        "number": {
          "$ref": "#/$defs/decimalString"
        },
        "hash": {
          "$ref": "#/$defs/bytes32"
        },
        "timestamp": {
          "$ref": "#/$defs/utcTimestamp"
        }
      }
    },
    "chain": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "chainId",
        "network",
        "rpcUrl",
        "explorerUrl",
        "evmVersion",
        "latestSnapshot",
        "finalizedSnapshot",
        "dependencyStateReadTag"
      ],
      "properties": {
        "chainId": {
          "enum": [
            46630,
            421614
          ]
        },
        "network": {
          "enum": [
            "Robinhood Chain Testnet",
            "Arbitrum Sepolia"
          ]
        },
        "rpcUrl": {
          "enum": [
            "https://rpc.testnet.chain.robinhood.com",
            "https://sepolia-rollup.arbitrum.io/rpc"
          ]
        },
        "explorerUrl": {
          "enum": [
            "https://explorer.testnet.chain.robinhood.com",
            "https://sepolia.arbiscan.io"
          ]
        },
        "evmVersion": {
          "const": "cancun"
        },
        "latestSnapshot": {
          "$ref": "#/$defs/blockSnapshot"
        },
        "finalizedSnapshot": {
          "$ref": "#/$defs/blockSnapshot"
        },
        "dependencyStateReadTag": {
          "const": "latest"
        }
      }
    },
    "dependencyProvenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identityStatus",
        "uniswapOfficial46630ListingAvailable",
        "projectUsageScope",
        "sourceUrls",
        "acceptance"
      ],
      "properties": {
        "identityStatus": {
          "enum": [
            "PROJECT_PINNED_UNISWAP_V4_TEST_DEPENDENCY_NOT_OFFICIAL_46630",
            "OFFICIAL_UNISWAP_V4_ARBITRUM_SEPOLIA"
          ]
        },
        "uniswapOfficial46630ListingAvailable": {
          "const": false
        },
        "projectUsageScope": {
          "const": "TESTNET_REHEARSAL_ONLY"
        },
        "sourceUrls": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^https://\\S+$"
          }
        },
        "acceptance": {
          "const": "EXPLICIT_TEST_ONLY_PIN_REQUIRED_BEFORE_BROADCAST"
        }
      }
    },
    "dependency": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "address",
        "runtimeCodeHash",
        "runtimeCodeSize",
        "observationBlockHash"
      ],
      "properties": {
        "name": {
          "enum": [
            "CANONICAL_CREATE2_DEPLOYER",
            "POOL_MANAGER",
            "POSITION_MANAGER",
            "PERMIT2",
            "UNIVERSAL_ROUTER",
            "V4_QUOTER",
            "STATE_VIEW"
          ]
        },
        "address": {
          "$ref": "#/$defs/address"
        },
        "runtimeCodeHash": {
          "$ref": "#/$defs/bytes32"
        },
        "runtimeCodeSize": {
          "type": "integer",
          "minimum": 1
        },
        "observationBlockHash": {
          "$ref": "#/$defs/bytes32"
        }
      }
    },
    "deterministicDeployment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "broadcastStatus",
        "entrypoint",
        "previewEntrypoint",
        "canonicalCreate2Deployer",
        "orchestratorSaltDomain",
        "helperSaltDomain",
        "factorySaltDomain",
        "ordinaryComponentCount",
        "ordinaryComponentOrder",
        "requiredHookPermissionMask",
        "hookAddressBitMask",
        "maximumHelperSaltAttempts",
        "runtimeGraphAtomic",
        "retryPreservesAddresses",
        "activationSeparate"
      ],
      "properties": {
        "broadcastStatus": {
          "enum": [
            "NOT_BROADCAST",
            "BROADCAST_VERIFIED"
          ]
        },
        "entrypoint": {
          "const": "contracts/script/v1/DeployV1Deterministic.s.sol:DeployV1Deterministic"
        },
        "previewEntrypoint": {
          "const": "contracts/script/v1/DeployV1Deterministic.s.sol:DeployV1Deterministic.preview"
        },
        "canonicalCreate2Deployer": {
          "$ref": "#/$defs/address"
        },
        "orchestratorSaltDomain": {
          "$ref": "#/$defs/bytes32"
        },
        "helperSaltDomain": {
          "$ref": "#/$defs/bytes32"
        },
        "factorySaltDomain": {
          "$ref": "#/$defs/bytes32"
        },
        "ordinaryComponentCount": {
          "const": 16
        },
        "ordinaryComponentOrder": {
          "type": "array",
          "minItems": 16,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          }
        },
        "requiredHookPermissionMask": {
          "const": "0x2044"
        },
        "hookAddressBitMask": {
          "const": "0x3fff"
        },
        "maximumHelperSaltAttempts": {
          "const": 500000
        },
        "runtimeGraphAtomic": {
          "const": true
        },
        "retryPreservesAddresses": {
          "const": true
        },
        "activationSeparate": {
          "const": true
        }
      }
    },
    "forkEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "network",
        "chainId",
        "blockNumber",
        "blockHash",
        "testPath",
        "reportPath"
      ],
      "properties": {
        "status": {
          "enum": [
            "OPEN",
            "PASSED"
          ]
        },
        "network": {
          "const": "Robinhood Chain"
        },
        "chainId": {
          "const": 4663
        },
        "blockNumber": {
          "$ref": "#/$defs/decimalString"
        },
        "blockHash": {
          "$ref": "#/$defs/bytes32"
        },
        "testPath": {
          "const": "contracts/test/v1/fork/V1ProductForkE2E.t.sol"
        },
        "reportPath": {
          "const": "deployments/evidence/v1-deployment-gates.json"
        }
      }
    },
    "deploymentGateId": {
      "enum": [
        "V1-DEPLOY-CHAIN-SNAPSHOT-01",
        "V1-DEPLOY-ARTIFACT-CODEHASH-01",
        "V1-DEPLOY-CREATE2-VECTORS-01",
        "V1-DEPLOY-HOOK-MASK-01",
        "V1-DEPLOY-PERMISSIONS-01",
        "V1-DEPLOY-ABI-DIFF-01",
        "V1-DEPLOY-PRODUCT-FORK-E2E-01"
      ]
    },
    "gateEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gateId",
        "status",
        "evidence"
      ],
      "properties": {
        "gateId": {
          "$ref": "#/$defs/deploymentGateId"
        },
        "status": {
          "enum": [
            "OPEN",
            "CLOSED"
          ]
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "target": {
            "const": "ROBINHOOD_CHAIN_TESTNET_REHEARSAL"
          }
        }
      },
      "then": {
        "properties": {
          "chain": {
            "properties": {
              "chainId": {
                "const": 46630
              },
              "network": {
                "const": "Robinhood Chain Testnet"
              },
              "rpcUrl": {
                "const": "https://rpc.testnet.chain.robinhood.com"
              },
              "explorerUrl": {
                "const": "https://explorer.testnet.chain.robinhood.com"
              }
            },
            "type": "object"
          },
          "dependencyProvenance": {
            "properties": {
              "identityStatus": {
                "const": "PROJECT_PINNED_UNISWAP_V4_TEST_DEPENDENCY_NOT_OFFICIAL_46630"
              }
            },
            "type": "object"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "target": {
            "const": "ARBITRUM_SEPOLIA_V4_INTEGRATION"
          }
        }
      },
      "then": {
        "properties": {
          "chain": {
            "properties": {
              "chainId": {
                "const": 421614
              },
              "network": {
                "const": "Arbitrum Sepolia"
              },
              "rpcUrl": {
                "const": "https://sepolia-rollup.arbitrum.io/rpc"
              },
              "explorerUrl": {
                "const": "https://sepolia.arbiscan.io"
              }
            },
            "type": "object"
          },
          "dependencyProvenance": {
            "properties": {
              "identityStatus": {
                "const": "OFFICIAL_UNISWAP_V4_ARBITRUM_SEPOLIA"
              }
            },
            "type": "object"
          },
          "productionTargetChainId": {
            "const": 4663
          }
        },
        "required": [
          "productionTargetChainId"
        ]
      }
    }
  ]
}
