{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tickergarden.local/schemas/v1-deployment-gate-evidence.schema.json",
  "title": "TickerGarden V1 deployment gate evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "reportKind",
    "executionSpecId",
    "verificationDate",
    "scope",
    "readinessOutcome",
    "testnetChainEvidence",
    "externalDependencies",
    "artifactEvidence",
    "orchestrationEvidence",
    "forkEvidence",
    "commands",
    "gates",
    "limitations"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "reportKind": {
      "const": "TICKERGARDEN_V1_DEPLOYMENT_GATE_EVIDENCE"
    },
    "executionSpecId": {
      "const": "V1-EXEC-11"
    },
    "verificationDate": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "scope": {
      "const": "ROBINHOOD_TESTNET_REHEARSAL_AND_MAINNET_STATE_FORK"
    },
    "readinessOutcome": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "technicalDeploymentGatesClosed",
        "state",
        "productionReady",
        "broadcastPerformed",
        "broadcastAuthorized",
        "productionGatesOpen"
      ],
      "properties": {
        "technicalDeploymentGatesClosed": {
          "const": true
        },
        "state": {
          "const": "DEPLOYMENT_ELIGIBLE"
        },
        "productionReady": {
          "const": false
        },
        "broadcastPerformed": {
          "const": false
        },
        "broadcastAuthorized": {
          "const": false
        },
        "productionGatesOpen": {
          "type": "integer",
          "const": 8
        }
      }
    },
    "testnetChainEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "chainId",
        "pinnedLatestBlock",
        "pinnedLatestBlockHash",
        "pinnedFinalizedBlock",
        "pinnedFinalizedBlockHash",
        "liveVerifiedCurrentLatestBlock",
        "liveVerifiedCurrentFinalizedBlock",
        "dependencyStateReadTag",
        "dependenciesChecked",
        "positionManagerBindingsChecked",
        "officialUniswap46630ListingAvailable",
        "dependencyAcceptance"
      ],
      "properties": {
        "chainId": {
          "const": 46630
        },
        "pinnedLatestBlock": {
          "$ref": "#/$defs/decimalString"
        },
        "pinnedLatestBlockHash": {
          "$ref": "#/$defs/hash"
        },
        "pinnedFinalizedBlock": {
          "$ref": "#/$defs/decimalString"
        },
        "pinnedFinalizedBlockHash": {
          "$ref": "#/$defs/hash"
        },
        "liveVerifiedCurrentLatestBlock": {
          "$ref": "#/$defs/decimalString"
        },
        "liveVerifiedCurrentFinalizedBlock": {
          "$ref": "#/$defs/decimalString"
        },
        "dependencyStateReadTag": {
          "const": "latest"
        },
        "dependenciesChecked": {
          "const": 7
        },
        "positionManagerBindingsChecked": {
          "const": 2
        },
        "officialUniswap46630ListingAvailable": {
          "const": false
        },
        "dependencyAcceptance": {
          "const": "EXPLICIT_TEST_ONLY_PIN_REQUIRED_BEFORE_BROADCAST"
        }
      }
    },
    "externalDependencies": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "address",
          "runtimeCodeHash",
          "runtimeCodeSize"
        ],
        "properties": {
          "name": {
            "$ref": "#/$defs/nonEmptyString"
          },
          "address": {
            "$ref": "#/$defs/address"
          },
          "runtimeCodeHash": {
            "$ref": "#/$defs/hash"
          },
          "runtimeCodeSize": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "artifactEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "productArtifactManifest",
        "productArtifactManifestSha256",
        "productArtifactManifestHash",
        "moduleCount",
        "compilerVersion",
        "files"
      ],
      "properties": {
        "productArtifactManifest": {
          "const": "spec/v1_product_artifact_manifest.json"
        },
        "productArtifactManifestSha256": {
          "$ref": "#/$defs/hash"
        },
        "productArtifactManifestHash": {
          "$ref": "#/$defs/hash"
        },
        "moduleCount": {
          "const": 19
        },
        "compilerVersion": {
          "const": "0.8.26+commit.8a97fa7a"
        },
        "files": {
          "type": "array",
          "minItems": 7,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/fileHash"
          }
        }
      }
    },
    "orchestrationEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ordinaryComponentCount",
        "atomicRollback",
        "deterministicRetry",
        "oneShot",
        "hookMask",
        "testsPassed"
      ],
      "properties": {
        "ordinaryComponentCount": {
          "const": 16
        },
        "atomicRollback": {
          "const": true
        },
        "deterministicRetry": {
          "const": true
        },
        "oneShot": {
          "const": true
        },
        "hookMask": {
          "const": "0x2044"
        },
        "testsPassed": {
          "const": 3
        }
      }
    },
    "forkEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "chainId",
        "l2BlockNumber",
        "l2BlockHash",
        "l1BlockNumber",
        "testPath",
        "result",
        "realStockToken",
        "realBeacon",
        "realImplementation",
        "realPoolManager",
        "realPositionManager",
        "stockQuoteAdmissionExercised",
        "atomicGraduationExercised",
        "rageQuitExercised",
        "syntheticStockBalanceFunding"
      ],
      "properties": {
        "chainId": {
          "const": 4663
        },
        "l2BlockNumber": {
          "$ref": "#/$defs/decimalString"
        },
        "l2BlockHash": {
          "$ref": "#/$defs/hash"
        },
        "l1BlockNumber": {
          "$ref": "#/$defs/decimalString"
        },
        "testPath": {
          "const": "contracts/test/v1/fork/V1ProductForkE2E.t.sol"
        },
        "result": {
          "const": "PASSED"
        },
        "realStockToken": {
          "$ref": "#/$defs/address"
        },
        "realBeacon": {
          "$ref": "#/$defs/address"
        },
        "realImplementation": {
          "$ref": "#/$defs/address"
        },
        "realPoolManager": {
          "$ref": "#/$defs/address"
        },
        "realPositionManager": {
          "$ref": "#/$defs/address"
        },
        "stockQuoteAdmissionExercised": {
          "const": true
        },
        "atomicGraduationExercised": {
          "const": true
        },
        "rageQuitExercised": {
          "const": true
        },
        "syntheticStockBalanceFunding": {
          "const": true
        }
      }
    },
    "commands": {
      "type": "array",
      "minItems": 7,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "command",
          "result"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^C[1-9][0-9]*$"
          },
          "command": {
            "$ref": "#/$defs/nonEmptyString"
          },
          "result": {
            "const": "PASS"
          }
        }
      }
    },
    "gates": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "gateId",
          "status",
          "evidenceRefs"
        ],
        "properties": {
          "gateId": {
            "$ref": "#/$defs/gateId"
          },
          "status": {
            "const": "CLOSED"
          },
          "evidenceRefs": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "$ref": "#/$defs/nonEmptyString"
            }
          }
        }
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 4,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/nonEmptyString"
      }
    },
    "applicability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "reason"
      ],
      "properties": {
        "status": {
          "enum": [
            "CURRENT",
            "STALE"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "$defs": {
    "address": {
      "type": "string",
      "pattern": "^0x(?!0{40}$)[0-9a-fA-F]{40}$"
    },
    "hash": {
      "type": "string",
      "pattern": "^0x(?!0{64}$)[0-9a-fA-F]{64}$"
    },
    "decimalString": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$"
    },
    "nonEmptyString": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "fileHash": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "sha256": {
          "$ref": "#/$defs/hash"
        }
      }
    },
    "gateId": {
      "enum": [
        "V1-DEPLOY-CHAIN-SNAPSHOT-01",
        "V1-DEPLOY-ARTIFACT-CODEHASH-01",
        "V1-DEPLOY-CREATE2-VECTORS-01",
        "V1-DEPLOY-HOOK-MASK-01",
        "V1-DEPLOY-PERMISSIONS-01",
        "V1-DEPLOY-ABI-DIFF-01",
        "V1-DEPLOY-PRODUCT-FORK-E2E-01"
      ]
    }
  }
}
