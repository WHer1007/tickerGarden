          },
          "ponsBaselineId": {
            "type": "string",
            "pattern": "^0x[0-9a-f]{64}$"
          },
          "sourceVersion": {
            "type": "integer",
            "minimum": 1
          },
          "launchPhase": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          },
          "marketStatus": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
