      },
      "CurveProgress": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "realQuoteReserve": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)$"
          },
          "sellableTokens": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)$"
          },
          "reservedTokens": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)$"
