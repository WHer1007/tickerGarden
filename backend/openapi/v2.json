                "type": "null"
              }
            ]
          }
        },
        "required": [
          "realQuoteReserve",
          "sellableTokens",
          "reservedTokens",
          "accruedCurveFees",
          "readyToGraduate",
          "sweptAt"
        ]
      },
      "MarketReadModel": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "marketId": {
            "type": "string",
            "pattern": "^0x[0-9a-f]{64}$"
          },
          "assetUid": {
            "type": "string",
            "pattern": "^0x[0-9a-f]{64}$"
          },
          "memeToken": {
            "type": "string",
            "pattern": "^0x[0-9a-f]{40}$"
