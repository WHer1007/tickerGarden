            "type": "string",
            "pattern": "^0x[0-9a-f]{40}$"
          },
          "hook": {
            "type": "string",
            "pattern": "^0x[0-9a-f]{40}$"
          },
          "launchLocker": {
            "type": "string",
            "pattern": "^0x[0-9a-f]{40}$"
          },
          "graduationExecutor": {
            "type": "string",
            "pattern": "^0x[0-9a-f]{40}$"
          },
          "curveTradingEnabled": {
            "type": "boolean"
          },
          "poolTradingEnabled": {
            "type": "boolean"
          },
          "sourceVersion": {
            "type": "integer",
            "minimum": 1
          },
          "launchPhase": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          },
          "marketStatus": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          }
