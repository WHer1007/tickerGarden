          "marketId",
          "assetUid",
          "memeToken",
          "curve",
          "gauge",
          "quoteAsset",
          "quoteAssetConfigId",
          "ponsBaselineId",
          "sourceVersion",
          "launchPhase",
          "marketStatus",
          "stakeSaturationAmount",
          "curveProgress",
          "poolId",
          "poolKey",
          "canonicalRoute",
          "source"
