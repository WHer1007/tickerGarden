{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm ci && npm ci --prefix ../../services/backend-ts --ignore-scripts --omit=dev",
  "buildCommand": "node ../../tools/deployment-boundary.mjs auto web && npm run build:vercel",
  "regions": [
    "sin1"
  ],
  "functions": {
    "api/rpc.ts": {
      "maxDuration": 20
    },
    "api/market-page.ts": {
      "maxDuration": 10,
      "includeFiles": "dist/market-shell.html"
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self'; connect-src 'self' https:; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'; frame-src 'none'; worker-src 'self' blob:"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": ".*\\.vercel\\.app"
        }
      ],
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/explore",
      "destination": "/explore/index.html"
    },
    {
      "source": "/trade",
      "destination": "/api/market-page"
    },
    {
      "source": "/create",
      "destination": "/create/index.html"
    },
    {
      "source": "/stats",
      "destination": "/stats/index.html"
    },
    {
      "source": "/stats/stocks",
      "destination": "/stats/stocks/index.html"
    },
    {
      "source": "/claim",
      "destination": "/claim/index.html"
    },
    {
      "source": "/stake",
      "destination": "/stake/index.html"
    },
    {
      "source": "/docs",
      "destination": "/docs/index.html"
    },
    {
      "source": "/privacy",
      "destination": "/privacy/index.html"
    },
    {
      "source": "/terms",
      "destination": "/terms/index.html"
    }
  ],
  "redirects": [
    {
      "source": "/rewards",
      "destination": "/claim",
      "permanent": true
    },
    {
      "source": "/rewards.html",
      "destination": "/claim",
      "permanent": true
    },
    {
      "source": "/market",
      "destination": "/explore",
      "permanent": true
    },
    {
      "source": "/market.html",
      "destination": "/explore",
      "permanent": true
    },
    {
      "source": "/markets",
      "destination": "/explore",
      "permanent": true
    },
    {
      "source": "/markets.html",
      "destination": "/explore",
      "permanent": true
    },
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/explore.html",
      "destination": "/explore",
      "permanent": true
    },
    {
      "source": "/trade.html",
      "destination": "/trade",
      "permanent": true
    },
    {
      "source": "/create.html",
      "destination": "/create",
      "permanent": true
    },
    {
      "source": "/stats.html",
      "destination": "/stats",
      "permanent": true
    },
    {
      "source": "/stats/stocks.html",
      "destination": "/stats/stocks",
      "permanent": true
    },
    {
      "source": "/claim.html",
      "destination": "/claim",
      "permanent": true
    },
    {
      "source": "/stake.html",
      "destination": "/stake",
      "permanent": true
    },
    {
      "source": "/docs.html",
      "destination": "/docs",
      "permanent": true
    },
    {
      "source": "/privacy.html",
      "destination": "/privacy",
      "permanent": true
    },
    {
      "source": "/terms.html",
      "destination": "/terms",
      "permanent": true
    }
  ]
}
