
# Public HTTPS gateway origin for ipfs:// metadata and logos. Never put an upload JWT here.
VITE_IPFS_GATEWAY=

# Public HTTPS Pipeline origin for immediate verified launch discovery.
# Configure its TG_ALLOWED_ORIGINS to include the deployed Web origin.
VITE_V1_PIPELINE_URL=

# Wallet-snapshot markets: mark their reviewed VITE_MARKET_RELEASE_CATALOG entry
# with "holderRewardMode":"wallet-snapshot-v1". Read data/proofs come from the
# Read API /v1/holder-snapshots endpoint (backend integration still required).
# Enable only after funded publication + real claim E2E; leave unset for now.
VITE_HOLDER_SNAPSHOT_RELEASE_APPROVAL=
