{
  "name": "tickergarden-v1-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "node ../../tools/environment.mjs run auto web",
    "preview": "vite preview",
    "generate:abis": "node scripts/generate-v1-abis.mjs",
    "generate:client": "node scripts/sync-v1-read-client.mjs",
    "generate": "npm run generate:abis && npm run generate:client",
    "check:abis": "node scripts/generate-v1-abis.mjs --check",
    "check:client": "node scripts/sync-v1-read-client.mjs --check",
    "check:generated": "npm run check:abis && npm run check:client",
    "typecheck": "tsc -p tsconfig.json",
    "test": "npm run check:generated && npm run typecheck && node --experimental-strip-types --test tests/*.test.ts",
    "build": "npm run check:generated && npm run typecheck && vite build",
    "accept:preview:browser": "node scripts/accept-preview-browser.mjs",
    "start": "node security/serve.mjs"
  },
  "dependencies": {
    "@phosphor-icons/web": "^2.1.2",
    "three": "0.185.1",
    "viem": "^2.56.3",
    "vite": "^6.4.2"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/three": "0.185.4",
    "playwright-core": "1.63.0",
    "typescript": "^5.9.3"
  }
}
